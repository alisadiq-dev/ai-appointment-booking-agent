# DOCUMENTATION ONLY: every value below is commented out on purpose.
# SnapDeploy (the production host) re-applies the KEY=value lines of this file over the values set
# in its dashboard after each deploy, which switched APP_ENV back to development and
# CALENDAR_ENABLED to false in production. Keeping no active assignments here avoids that.
# For local development, turn the local defaults on (writes .env, which is gitignored):
#   sed -E 's/^# (APP_ENV|LOG_LEVEL|SUPABASE_URL|DATABASE_URL|BUSINESS_TIMEZONE|SLOT_INTERVAL_MINUTES|CALENDAR_ENABLED)=/\1=/' .env.example > .env
# Never put real or production values in this file (docs/deploy.md).
#
# APP_ENV=development
# LOG_LEVEL=INFO

# Supabase project URL. Tokens are verified against {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Local: http://127.0.0.1:54321   Hosted: https://<project-ref>.supabase.co
# If unset, every authenticated request fails closed with 503.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWT_AUDIENCE=authenticated
# JWKS_CACHE_SECONDS=300
# JWKS_TIMEOUT_SECONDS=5

# Postgres connection used by the backend (raw SQL via psycopg). The role must be able to
# bypass RLS (e.g. `postgres`); every query filters by user_id itself.
# Local Supabase default shown. Behind a transaction pooler (Supavisor, port 6543) this app
# already disables prepared statements.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=10

# Business rules. Stored times are UTC; business hours are wall-clock times in this IANA zone.
# BUSINESS_TIMEZONE=Asia/Karachi
# SLOT_INTERVAL_MINUTES=15
# Most upcoming (confirmed, not yet started) bookings one user may hold; applies to REST and chat.
# MAX_ACTIVE_BOOKINGS_PER_USER=3

# Google Calendar (service account). Leave CALENDAR_ENABLED=false for local dev without Google.
# Must be true in production. When true, the next two are required and validated at startup.
# Keep real values OUTSIDE the repo (e.g. ~/.secrets/booking-agent.env), see docs/google-calendar.md
# CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_ID=<calendar id from Calendar settings, ends with @group.calendar.google.com>
# GOOGLE_SERVICE_ACCOUNT_JSON=<the service account key file contents as one line of JSON>
# CALENDAR_TIMEOUT_SECONDS=10
# CALENDAR_NUM_RETRIES=3

# Gemini (booking agent language model). Without a key the agent replies with a safe fallback
# and never books. Keep the real key OUTSIDE the repo (e.g. ~/.secrets/booking-agent.env).
# GEMINI_API_KEY=<key from Google AI Studio>
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=10

# Chat rate limit: per user id (from the JWT), in memory, PER INSTANCE (run a single instance).
# CHAT_RATE_LIMIT_REQUESTS=10
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
