# Copy to .env for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO

# Supabase project URL. Tokens are verified against {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Local: http://127.0.0.1:54321   Hosted: https://<project-ref>.supabase.co
# If unset, every authenticated request fails closed with 503.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWT_AUDIENCE=authenticated
# JWKS_CACHE_SECONDS=300
# JWKS_TIMEOUT_SECONDS=5

# Postgres connection used by the backend (raw SQL via psycopg). The role must be able to
# bypass RLS (e.g. `postgres`); every query filters by user_id itself.
# Local Supabase default shown. Behind a transaction pooler (Supavisor, port 6543) this app
# already disables prepared statements.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=10

# Business rules. Stored times are UTC; business hours are wall-clock times in this IANA zone.
BUSINESS_TIMEZONE=Asia/Karachi
SLOT_INTERVAL_MINUTES=15
